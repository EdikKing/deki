{
  "name": "deki",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev": "pnpm --filter @deki-ai/desktop dev",
    "build": "pnpm cli:build && pnpm --filter @deki-ai/desktop build",
    "cli:build": "pnpm --filter @deki-ai/cli build",
    "deki": "pnpm cli:build && node apps/cli/dist/deki.js",
    "package": "pnpm --filter @deki-ai/desktop package",
    "package:dir": "pnpm --filter @deki-ai/desktop package:dir",
    "package:mac": "pnpm --filter @deki-ai/desktop package:mac",
    "package:mac:unsigned": "pnpm --filter @deki-ai/desktop package:mac:unsigned",
    "package:win": "pnpm --filter @deki-ai/desktop package:win",
    "package:linux": "pnpm --filter @deki-ai/desktop package:linux",
    "release:validate": "node scripts/validate-release-tag.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "pnpm build && playwright test --config playwright.config.ts",
    "test:electron:launch": "node scripts/smoke-electron-launch.mjs",
    "license:generate": "node scripts/generate-third-party-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "eslint": "10.0.1",
    "globals": "16.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
