{
  "name": "@deki-ai/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deki local-first AI development workspace",
  "author": "Edik Labs",
  "main": "./out/main/index.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm --dir ../.. license:generate && electron-vite build",
    "package": "pnpm --dir ../.. cli:build && pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "@deki-ai/agent-runtime": "workspace:*",
    "@deki-ai/config": "workspace:*",
    "@deki-ai/git-checkpoint": "workspace:*",
    "@deki-ai/mcp-manager": "workspace:*",
    "@deki-ai/memory-engine": "workspace:*",
    "@deki-ai/permission-engine": "workspace:*",
    "@deki-ai/settings": "workspace:*",
    "@deki-ai/shared": "workspace:*",
    "@deki-ai/tool-gateway": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "ai.deki.desktop",
    "productName": "Deki",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "../cli/dist/deki.js",
        "to": "cli/deki.js"
      }
    ],
    "asar": true,
    "mac": {
      "target": ["dir"]
    },
    "win": {
      "target": ["dir"]
    },
    "linux": {
      "target": ["dir"],
      "category": "Development"
    }
  }
}
