{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@deki-ai/shared": ["./packages/shared/src/index.ts"],
      "@deki-ai/config": ["./packages/config/src/index.ts"],
      "@deki-ai/tool-gateway": ["./packages/tool-gateway/src/index.ts"],
      "@deki-ai/mcp-manager": ["./packages/mcp-manager/src/index.ts"],
      "@deki-ai/memory-engine": ["./packages/memory-engine/src/index.ts"],
      "@deki-ai/git-checkpoint": ["./packages/git-checkpoint/src/index.ts"],
      "@deki-ai/settings": ["./packages/settings/src/index.ts"],
      "@deki-ai/permission-engine": ["./packages/permission-engine/src/index.ts"],
      "@deki-ai/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@deki-ai/task-orchestrator": ["./packages/task-orchestrator/src/index.ts"]
      ,"@deki-ai/runner": ["./packages/runner/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
