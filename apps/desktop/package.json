{
  "name": "@deki-ai/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deki local-first AI development workspace",
  "author": "Edik Labs",
  "main": "./out/main/index.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm --dir ../.. license:generate && electron-vite build && node ../../scripts/verify-desktop-bundle.mjs",
    "package": "pnpm --dir ../.. cli:build && pnpm build && electron-builder --publish never",
    "package:dir": "pnpm --dir ../.. cli:build && pnpm build && electron-builder --dir",
    "package:mac": "pnpm --dir ../.. cli:build && pnpm build && electron-builder --mac dmg zip --universal --publish never",
    "package:win": "pnpm --dir ../.. cli:build && pnpm build && electron-builder --win nsis portable --x64 --publish never",
    "package:linux": "pnpm --dir ../.. cli:build && pnpm build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "@deki-ai/agent-runtime": "workspace:*",
    "@deki-ai/config": "workspace:*",
    "@deki-ai/git-checkpoint": "workspace:*",
    "@deki-ai/mcp-manager": "workspace:*",
    "@deki-ai/memory-engine": "workspace:*",
    "@deki-ai/permission-engine": "workspace:*",
    "@deki-ai/settings": "workspace:*",
    "@deki-ai/shared": "workspace:*",
    "@deki-ai/tool-gateway": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@lobehub/icons-static-svg": "1.94.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "ai.deki.desktop",
    "productName": "Deki",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "../cli/dist/deki.js",
        "to": "cli/deki.js"
      }
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Edik Labs",
      "synopsis": "Local-first AI development workspace"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
